[Unit]
Description=Prompt Forge UI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/prompt_forge
ExecStart=/root/prompt_forge/venv/bin/python -m prompt_forge --ui --host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
